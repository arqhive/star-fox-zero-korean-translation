[
 {
  "id": "0000.0",
  "event": "FOX_VENOM_002",
  "font": 7,
  "ja": "クッ!スターウルフか\nそいつは どうかな?",
  "ko": "큭! 스타울프인가.\n과연 그럴까?"
 },
 {
  "id": "0001.0",
  "event": "FOX_VENOM_003",
  "font": 7,
  "ja": "あなたは!?",
  "ko": "당신은!?"
 },
 {
  "id": "0002.0",
  "event": "FOX_VENOM_004",
  "font": 7,
  "ja": "父さん!!",
  "ko": "아버지!!"
 },
 {
  "id": "0003.0",
  "event": "FOX_VENOM_005",
  "font": 7,
  "ja": "いや・・・\n何でもない",
  "ko": "아니...\n아무것도 아니야."
 },
 {
  "id": "0004.0",
  "event": "FOX_VENOM_006",
  "font": 7,
  "ja": "首を洗って待ってろよ\nアンドルフ",
  "ko": "목숨 내놓을 각오나 해라,\n안돌프."
 },
 {
  "id": "0005.0",
  "event": "FOX_VENOM_007",
  "font": 7,
  "ja": "ペパー将軍!?\n一体どういうことなんですか?",
  "ko": "페퍼 장군!?\n대체 어떻게 된 겁니까?"
 },
 {
  "id": "0006.0",
  "event": "FOX_VENOM_008",
  "font": 7,
  "ja": "・・・引き受けましょう\n奴の好きにはさせません!",
  "ko": "...맡겠습니다.\n놈의 뜻대로 두지 않겠습니다!"
 },
 {
  "id": "0007.0",
  "event": "FOX_VENOM_009",
  "font": 7,
  "ja": "父さん!!",
  "ko": "아버지!!"
 },
 {
  "id": "0008.0",
  "event": "FALCO_VENOM_001",
  "font": 7,
  "ja": "ったく!大した奴だぜ\nリーダー",
  "ko": "참 나! 대단한 녀석이라니까,\n리더."
 },
 {
  "id": "0009.0",
  "event": "PEPPY_VENOM_001",
  "font": 7,
  "ja": "無事だったか\nフォックス!!",
  "ko": "무사했구나,\n폭스!!"
 },
 {
  "id": "0010.0",
  "event": "PEPPY_VENOM_002",
  "font": 7,
  "ja": "・・・どうした?\nフォックス!",
  "ko": "...왜 그러냐?\n폭스!"
 },
 {
  "id": "0011.0",
  "event": "SLIPPY_VENOM_001",
  "font": 7,
  "ja": "すごいよ\nさすが フォックスだ!",
  "ko": "대단해.\n역시 폭스야!"
 },
 {
  "id": "0012.0",
  "event": "PEPPER_VENOM_004",
  "font": 7,
  "ja": "まさか惑星ベノム自体が\n転送装置だったとは・・・",
  "ko": "설마 행성 베놈 자체가\n전송 장치였을 줄이야..."
 },
 {
  "id": "0013.0",
  "event": "PEPPER_VENOM_005",
  "font": 7,
  "ja": "どこかにアンドルフへの\n手がかりがあるはずだ!",
  "ko": "어딘가에 안돌프에 대한\n단서가 있을 걸세!"
 },
 {
  "id": "0014.0",
  "event": "PEPPER_VENOM_006",
  "font": 7,
  "ja": "急いでくれ フォックス\nもう時間がない!",
  "ko": "서둘러 주게, 폭스\n이제 시간이 없네!"
 },
 {
  "id": "0015.0",
  "event": "PEPPER_VENOM_007",
  "font": 7,
  "ja": "頼んだぞ フォックス・・・",
  "ko": "부탁하네, 폭스..."
 },
 {
  "id": "0016.0",
  "event": "PEPPER_VENOM_008",
  "font": 7,
  "ja": "上空に伸びるあの光・・・\n気にならんか フォックス",
  "ko": "상공으로 뻗은 저 빛...\n신경 쓰이지 않나, 폭스?"
 },
 {
  "id": "0017.0",
  "event": "PEPPER_VENOM_009",
  "font": 7,
  "ja": "光が弱まった その調子だ フォックス",
  "ko": "빛이 약해졌네. 그 기세일세, 폭스."
 },
 {
  "id": "0018.0",
  "event": "PEPPER_VENOM_016",
  "font": 7,
  "ja": "フォックス 聞こえるか?",
  "ko": "폭스, 들리나?"
 },
 {
  "id": "0019.0",
  "event": "PEPPER_VENOM_017",
  "font": 7,
  "ja": "黙っていてすまない\nこの転送装置はもともと我々とアンドルフが\n宇宙平和のために開発していたものなのだ",
  "ko": "숨겨서 미안하네.\n이 전송 장치는 원래 우리와 안돌프가\n우주 평화를 위해 개발하던 것이라네."
 },
 {
  "id": "0020.0",
  "event": "PEPPER_VENOM_018",
  "font": 7,
  "ja": "だが いつしかアンドルフはその強大な\n力にとりつかれ 独占することを企てた",
  "ko": "하지만 어느샌가 안돌프는 그 강대한\n힘에 사로잡혀 독점하려 들었지."
 },
 {
  "id": "0021.0",
  "event": "PEPPER_VENOM_019",
  "font": 7,
  "ja": "そのことを察知した我々は装置を利用し \n奴を異空間へと追放することに成功した",
  "ko": "그걸 알아챈 우리는 장치를 이용해\n놈을 이공간으로 추방하는 데 성공했네."
 },
 {
  "id": "0022.0",
  "event": "PEPPER_VENOM_020",
  "font": 7,
  "ja": "その成功は 君の父\nジェームズ・マクラウドのおかげでもある・・・",
  "ko": "그 성공은 자네 아버지\n제임스 맥클라우드 덕분이기도 하지..."
 },
 {
  "id": "0023.0",
  "event": "PEPPER_VENOM_021",
  "font": 7,
  "ja": "しかしアンドルフは蘇った・・・\n装置の威力は強化され さらに我々の\n装置まで操られてしまった",
  "ko": "하지만 안돌프는 되살아났네...\n장치의 위력은 강화되었고, 게다가\n우리 장치까지 조종당하고 말았지."
 },
 {
  "id": "0024.0",
  "event": "PEPPER_VENOM_022",
  "font": 7,
  "ja": "このままでは奴にライラット系すべてが\n支配されてしまうだろう・・・",
  "ko": "이대로라면 놈이 라일랫계 전체를\n지배하게 될 걸세..."
 },
 {
  "id": "0025.0",
  "event": "PEPPER_VENOM_023",
  "font": 7,
  "ja": "だからこそ 何としてもアンドルフを阻止し\nこの技術を破壊しなくてはならないのだ!",
  "ko": "그러니 반드시 안돌프를 저지하고\n이 기술을 파괴해야만 하네!"
 },
 {
  "id": "0026.0",
  "event": "PEPPER_VENOM_024",
  "font": 7,
  "ja": "やってくれるな フォックス?",
  "ko": "해 주겠나, 폭스?"
 },
 {
  "id": "0027.0",
  "event": "WOLF_VENOM_001",
  "font": 7,
  "ja": "そこまでだ\nスターフォックス!",
  "ko": "거기까지다,\n스타폭스!"
 },
 {
  "id": "0028.0",
  "event": "WOLF_VENOM_002",
  "font": 7,
  "ja": "どうした\nお前の力はそんなもんか?",
  "ko": "왜 그러지?\n네 힘은 그 정도냐?"
 },
 {
  "id": "0029.0",
  "event": "WOLF_VENOM_003",
  "font": 7,
  "ja": "やるじゃねえか\nだが ここまでだ!",
  "ko": "제법이군.\n하지만 여기까지다!"
 },
 {
  "id": "0030.0",
  "event": "WOLF_VENOM_004",
  "font": 7,
  "ja": "バッ バカな・・・\n俺よりも上なのか",
  "ko": "마, 말도 안 돼...\n나보다 위란 말인가."
 },
 {
  "id": "0031.0",
  "event": "WOLF_VENOM_005",
  "font": 7,
  "ja": "地面を駆けるのは\n俺達の方が上だ!",
  "ko": "땅 위를 달리는 건\n우리가 한 수 위다!"
 },
 {
  "id": "0032.0",
  "event": "LEON_VENOM_001",
  "font": 7,
  "ja": "ボウヤ この新しいオモチャで\n遊んであげよう",
  "ko": "꼬마, 이 새 장난감으로\n놀아 드리죠."
 },
 {
  "id": "0033.0",
  "event": "LEON_VENOM_002",
  "font": 7,
  "ja": "たっぷり かわいがってやる!",
  "ko": "실컷 예뻐해 드리죠!"
 },
 {
  "id": "0034.0",
  "event": "LEON_VENOM_003",
  "font": 7,
  "ja": "まだまだ\nお楽しみはこれからだ!",
  "ko": "아직입니다.\n즐거움은 이제부터죠!"
 },
 {
  "id": "0035.0",
  "event": "LEON_VENOM_004",
  "font": 7,
  "ja": "つ 強すぎる・・・",
  "ko": "너, 너무 강합니다..."
 },
 {
  "id": "0036.0",
  "event": "PIGMA_VENOM_001",
  "font": 7,
  "ja": "どこまでも甘い奴やのう\nほんま親父とそっくりやわ～",
  "ko": "끝까지 물러터진 놈이네.\n참말로 아비랑 똑 닮았다 아이가~"
 },
 {
  "id": "0037.0",
  "event": "PIGMA_VENOM_002",
  "font": 7,
  "ja": "なんや なんや～\nそんなもんかいなあ～!",
  "ko": "뭐꼬, 뭐꼬~\n고것밖에 안 되나~!"
 },
 {
  "id": "0038.0",
  "event": "PIGMA_VENOM_003",
  "font": 7,
  "ja": "な なんやて\nなかなかやるやないか!?",
  "ko": "뭐, 뭐라꼬\n제법 한다 아이가!?"
 },
 {
  "id": "0039.0",
  "event": "PIGMA_VENOM_004",
  "font": 7,
  "ja": "なんやと!\nこのわてが・・・",
  "ko": "뭐라꼬!\n이 내가..."
 },
 {
  "id": "0040.0",
  "event": "ANDREW_VENOM_001",
  "font": 7,
  "ja": "下等動物が アンドルフ様に\n会えると思ったか!",
  "ko": "하등 동물 주제에 안돌프 님을\n만날 수 있을 줄 알았느냐!"
 },
 {
  "id": "0041.0",
  "event": "ANDREW_VENOM_002",
  "font": 7,
  "ja": "お前達が来るような\n場所ではないのだ!",
  "ko": "네놈들이 올 만한\n곳이 아니다!"
 },
 {
  "id": "0042.0",
  "event": "ANDREW_VENOM_003",
  "font": 7,
  "ja": "どこまでも 我々に逆らう気か!",
  "ko": "끝까지 우리에게 거역할 셈이냐!"
 },
 {
  "id": "0043.0",
  "event": "ANDREW_VENOM_004",
  "font": 7,
  "ja": "わあああああ",
  "ko": "으아아아아아"
 },
 {
  "id": "0044.0",
  "event": "ANDROSS_VENOM_001",
  "font": 7,
  "ja": "待っていたぞ\nスターフォックス!",
  "ko": "기다리고 있었다\n스타폭스!"
 },
 {
  "id": "0045.0",
  "event": "ANDROSS_VENOM_002",
  "font": 7,
  "ja": "偉大な頭脳を持つ この私だけが\n宇宙を支配できるのだ",
  "ko": "위대한 두뇌를 가진 나만이\n우주를 지배할 수 있다."
 },
 {
  "id": "0046.0",
  "event": "ANDROSS_VENOM_003",
  "font": 7,
  "ja": "私に逆らうことがどれだけ無謀なことか\nたっぷりと味わうがよい!",
  "ko": "내게 거역하는 게 얼마나 무모한지\n똑똑히 맛보거라!"
 },
 {
  "id": "0047.0",
  "event": "ANDROSS_VENOM_004",
  "font": 7,
  "ja": "愚かな父親と同じようにな!!",
  "ko": "어리석은 네 아비처럼 말이다!!"
 },
 {
  "id": "0048.0",
  "event": "ANDROSS_VENOM_005",
  "font": 7,
  "ja": "ぐおおおおおお",
  "ko": "크오오오오오"
 },
 {
  "id": "0049.0",
  "event": "ANDROSS_VENOM_006",
  "font": 7,
  "ja": "逃しはしないぞ\nお前も道連れにしてやる!",
  "ko": "놓치지 않겠다.\n너도 길동무로 삼아 주마!"
 },
 {
  "id": "0050.0",
  "event": "ANDROSS_VENOM_007",
  "font": 7,
  "ja": "ペパーに上手く丸め込まれたな!!\nお前も親父と同じ道を歩むのか?",
  "ko": "페퍼의 꼬임에 제대로 넘어갔구나!!\n너도 아비와 같은 길을 걷겠느냐?"
 },
 {
  "id": "0051.0",
  "event": "ANDROSS_VENOM_008",
  "font": 7,
  "ja": "犬の犬になり下がったキツネよ!\nお前は永遠に犬のために生きるのか?",
  "ko": "개의 앞잡이로 전락한 여우여!\n넌 영원히 개를 위해 살 셈이냐?"
 },
 {
  "id": "0052.0",
  "event": "ANDROSS_VENOM_009",
  "font": 7,
  "ja": "あいつの言う平和など\n所詮 犬のための平和に過ぎん!",
  "ko": "그놈이 말하는 평화 따위\n결국 개를 위한 평화에 불과하다!"
 },
 {
  "id": "0053.0",
  "event": "ANDROSS_VENOM_010",
  "font": 7,
  "ja": "キツネよ!お前は永遠に犬のために\n生きるつもりか?",
  "ko": "여우여! 넌 영원히 개를 위해\n살 작정이냐?"
 },
 {
  "id": "0054.0",
  "event": "ANDROSS_VENOM_011",
  "font": 7,
  "ja": "ぐうぅぅ・・・\nまだ たてつくか!!",
  "ko": "크으으...\n아직도 대드느냐!!"
 },
 {
  "id": "0055.0",
  "event": "ANDROSS_VENOM_012",
  "font": 7,
  "ja": "お前の選択が間違いである事を\n悔いるがよい!",
  "ko": "네 선택이 틀렸음을\n후회하거라!"
 },
 {
  "id": "0056.0",
  "event": "ANDROSS_VENOM_013",
  "font": 7,
  "ja": "死にぞこないのキツネめ!\n邪魔をするなー!",
  "ko": "죽다 만 여우 놈!\n방해하지 마라~!"
 },
 {
  "id": "0057.0",
  "event": "JAMES_VENOM_001",
  "font": 7,
  "ja": "フォックス\n私について来い!",
  "ko": "폭스,\n나를 따라와라!"
 },
 {
  "id": "0058.0",
  "event": "JAMES_VENOM_002",
  "font": 7,
  "ja": "ここだ フォックス",
  "ko": "여기다, 폭스."
 },
 {
  "id": "0059.0",
  "event": "JAMES_VENOM_003",
  "font": 7,
  "ja": "気をつけろ!",
  "ko": "조심해라!"
 },
 {
  "id": "0060.0",
  "event": "JAMES_VENOM_004",
  "font": 7,
  "ja": "こっちだ フォックス!",
  "ko": "이쪽이다, 폭스!"
 },
 {
  "id": "0061.0",
  "event": "JAMES_VENOM_005",
  "font": 7,
  "ja": "自分の感覚を信じるんだ",
  "ko": "네 감각을 믿어라."
 },
 {
  "id": "0062.0",
  "event": "JAMES_VENOM_006",
  "font": 7,
  "ja": "どんな時も 決してあきらめるな\nフォックス",
  "ko": "어떤 때라도 절대 포기하지 마라,\n폭스."
 },
 {
  "id": "0063.0",
  "event": "JAMES_VENOM_007",
  "font": 7,
  "ja": "お前自身の目で見るんだ!!",
  "ko": "네 눈으로 똑똑히 봐라!!"
 },
 {
  "id": "0064.0",
  "event": "JAMES_VENOM_008",
  "font": 7,
  "ja": "道は一つだ 狙いを定めろ",
  "ko": "길은 하나다, 조준을 맞춰라."
 },
 {
  "id": "0065.0",
  "event": "JAMES_VENOM_009",
  "font": 7,
  "ja": "幻にだまされるな\n真実を見極めろ!",
  "ko": "환영에 속지 마라\n진실을 꿰뚫어 봐라!"
 },
 {
  "id": "0066.0",
  "event": "JAMES_VENOM_010",
  "font": 7,
  "ja": "強くなったな・・・\nフォックス",
  "ko": "강해졌구나...\n폭스"
 },
 {
  "id": "0067.0",
  "event": "JAMES_VENOM_011",
  "font": 7,
  "ja": "この先に行けば もう戻れないかも知れない",
  "ko": "이 앞으로 가면 다시는 못 돌아올지도 모른다."
 },
 {
  "id": "0068.0",
  "event": "JAMES_VENOM_012",
  "font": 7,
  "ja": "覚悟はできているようだな・・・\nついて来い フォックス!",
  "ko": "각오는 된 것 같구나...\n따라와라, 폭스!"
 },
 {
  "id": "0069.0",
  "event": "JAMES_VENOM_013",
  "font": 7,
  "ja": "お前は みんなのところへ戻れ フォックス",
  "ko": "너는 모두에게 돌아가라, 폭스."
 }
]